# Anthropic API 키 예시 파일
# 실제 키는 이 폴더(iCloud)가 아닌 ~/.anthropic/triz.env 에 보관합니다.
# 아래 명령으로 실제 파일을 만드세요:
#
#   mkdir -p ~/.anthropic
#   cp .env.example ~/.anthropic/triz.env
#   # 그 다음 ~/.anthropic/triz.env 를 열어 ANTHROPIC_API_KEY 값을 채워 넣으세요.
#
# 키 발급: https://console.anthropic.com/ → Settings → API Keys
# 결제: Billing → Add credits (최소 $5 필요)

ANTHROPIC_API_KEY=
